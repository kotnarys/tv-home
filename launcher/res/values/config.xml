<?xml version="1.0" encoding="utf-8"?>
<!-- DIGMA AI PONT / Changhong, Android 11. This changes launcher UI only. -->
<resources>
    <!-- Favourite apps, from left to right; unavailable TV apps are skipped. -->
    <string-array name="dock_apps">
        <item>ru.kinopoisk.tv</item>
        <item>com.vk.tv</item>
        <item>com.vk.vkvideo</item>
        <item>com.yandex.browser.tv</item>
        <item>com.android.vending</item>
    </string-array>

    <!-- Do not show helper/TV input components as regular app tiles. -->
    <string-array name="hidden_apps">
        <item>com.mediatek.wwtv.tvcenter</item>
    </string-array>

    <!-- Built-in TV tuner; appears under Inputs, if launchable. -->
    <string name="live_tv_package" translatable="false">com.mediatek.wwtv.tvcenter</string>

    <!-- No TCL-specific input picker on this DIGMA. -->
    <string name="input_picker_package" translatable="false"></string>

    <integer name="columns">5</integer>
</resources>
